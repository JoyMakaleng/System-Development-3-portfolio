<p>Customer Code: <?php echo htmlspecialchars($cust_code); ?></p>
    <p>Customer Name: <?php echo htmlspecialchars($cust_name); ?></p>
    <p>City: <?php echo htmlspecialchars($city); ?></p>
    <p>Distance: <?php echo htmlspecialchars($distance); ?> km</p>
    <p>Total Work Time: <?php echo htmlspecialchars($total_work_time); ?> hours</p>
    <p>Labour Cost: R<?php echo number_format($labour_cost, 0, '', ''); ?></p>
    <p>Total Cost Before 15% VAT: R<?php echo number_format($cost_before_vat, 0, '', ''); ?></p>
    <p>VAT (15%): R<?php echo number_format($vat_amount, 0, '', ''); ?></p>
    <p><strong>Total Project Cost: R<?php echo number_format($total_cost, 0, '', ''); ?></strong></p>

</body>
