<?php
require_once 'Dbconnection.php';

if ($_SERVER["REQUEST_METHOD"] !== "POST" || empty($_POST['customer']) || !isset($_POST['distance'])) {
    die("Error: Invalid form submission. Please fill in all fields.");
}

$customer_code = trim($_POST['customer']);
$distance_input = trim($_POST['distance']);

if (!is_numeric($distance_input) || $distance_input <= 0) {
    die("Error: Distance must be a valid positive number.");
}

$distance = (float)$distance_input;


$stmt = $conn->prepare("SELECT customer_code, name, city FROM customers WHERE customer_code = ?");
$stmt->bind_param("s", $customer_code);
$stmt->execute();
$result = $stmt->get_result();

if ($row = $result->fetch_assoc()) {
    $cust_code = $row['customer_code'];
    $cust_name = $row['name'];
    $city      = $row['city'];
} else {
    die("Error: Customer not found in the database.");
}
$stmt->close();
$conn->close();
$total_work_time  = $distance * 4.5;                
$hourly_fee_cost  = $total_work_time * 1250;        
$distance_charge  = $distance * 45;                  

$labour_cost      = 1000;                            
$equipment_cost   = 20000;                           

$cost_before_vat  = $hourly_fee_cost + $equipment_cost + $labour_cost;


$vat_amount       = $cost_before_vat * 0.15;         
$total_cost       = $cost_before_vat + $vat_amount;  
?>

